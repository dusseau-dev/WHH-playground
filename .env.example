# Shannon Environment Configuration
# Copy this file to .env and fill in your credentials

# Recommended output token configuration for larger tool outputs
CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# Adaptive thinking is enabled automatically on Opus 4.6/4.7. Set to false to disable.
# CLAUDE_ADAPTIVE_THINKING=false

# Shannon forwards your machine's /etc/hosts entries into the worker container. Set to false to disable.
# SHANNON_FORWARD_HOSTS=false

# Select exactly one provider and model. The model ID may contain additional colons.
SHANNON_AI_MODEL=anthropic:claude-sonnet-4-6

# Supply the selected provider's native credential:
ANTHROPIC_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-openai-api-key
# XAI_API_KEY=your-xai-api-key

# Generic Pi catalog providers use the provider ID from the catalog and this key:
# SHANNON_AI_MODEL=google:gemini-model-id
# SHANNON_AI_API_KEY=your-provider-api-key

# OpenAI-compatible or Anthropic-compatible gateway:
# SHANNON_AI_MODEL=openai:gateway-model-id
# SHANNON_AI_BASE_URL=https://your-proxy.example.com/v1
# SHANNON_AI_OPENAI_FORMAT=chat-completions  # or responses
# SHANNON_AI_API_KEY=your-gateway-key

# AWS Bedrock uses its normal credential chain:
# SHANNON_AI_MODEL=amazon-bedrock:us.anthropic.claude-sonnet-4-6
# AWS_REGION=us-east-1
# Choose one mechanism: AWS_BEARER_TOKEN_BEDROCK; AWS_PROFILE; access key plus
# secret (and optional session token); web identity; or ECS task-role variables.
# AWS_PROFILE=your-profile

# Legacy Anthropic tiers, Bedrock, and LiteLLM settings remain readable for
# migration only. New settings take precedence and emit one warning when mixed.
# Google Vertex AI is unsupported; legacy Vertex settings return migration
# guidance to select a supported provider or gateway.
